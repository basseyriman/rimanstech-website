# --- Required for production ---
# OpenAI: powers the RimansTech AI Assistant (/api/chat)
OPENAI_API_KEY=

# Resend: sends project enquiry emails (/api/enquiry)
# 1. Create account at https://resend.com
# 2. Add and verify rimanstech.com domain
# 3. Set EMAIL_FROM to a verified address, e.g. RimansTech <hello@rimanstech.com>
RESEND_API_KEY=
CONTACT_EMAIL=support@rimanstech.com
EMAIL_FROM=RimansTech <hello@rimanstech.com>

# Public site URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://rimanstech.com

# --- Optional social profiles (shown in footer) ---
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/basseyriman
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/basseyriman
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# --- Optional security (recommended for production) ---
# Cloudflare Turnstile — bot protection on /api/chat and /api/enquiry
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Upstash Redis — durable rate limiting across serverless instances
# Create a free database at https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Development notes ---
# Without OPENAI_API_KEY: chat shows a helpful offline fallback message.
# Without RESEND_API_KEY: enquiries are logged to the console in development only.
# In production, enquiry submission returns 503 if RESEND_API_KEY is missing.
